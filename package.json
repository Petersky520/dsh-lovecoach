{
  "name": "local-lovecoach",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "LoveCoach for DSH — attachment-aware dating coach: a lovecoach tool, a runtime skill, and dsh-go native panels.",
  "license": "MIT",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "恋爱教练",
      "en": "LoveCoach"
    },
    "icon": "heart",
    "wants": [
      "clipboard"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "coach-clip",
          "label": {
            "zh": "教练看剪贴板",
            "en": "Coach clip"
          },
          "icon": "heart"
        }
      ],
      "composer.tools": [
        {
          "id": "coach-panel",
          "label": {
            "zh": "恋爱教练",
            "en": "Coach"
          },
          "icon": "heart",
          "panel": "diagnose"
        }
      ],
      "panels": [
        {
          "id": "diagnose",
          "title": {
            "zh": "恋爱教练",
            "en": "LoveCoach"
          },
          "icon": "heart",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  }
}
